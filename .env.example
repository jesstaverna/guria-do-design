# ===== Supabase (projetos separados: dev / homologação / produção) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica   # pública por design; a segurança vem do RLS

# ===== Somente servidor — NUNCA prefixar com NEXT_PUBLIC_ =====
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que autoriza o agendador externo a chamar /api/worker
CRON_SECRET=gere-com-openssl-rand-hex-32
# URL pública do app (links de proposta/contrato/convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Google Drive (OPCIONAL) — seletor oficial de arquivos nas tarefas. Sem estas variáveis, o botão não aparece
# e o anexo por link continua funcionando. Passo a passo: docs/GOOGLE-DRIVE.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ===== Prospecção (OPCIONAL) — busca de empresas no Google Maps (Places API "New"). Chave da PLATAFORMA, só no servidor.
# Sem ela, a Prospecção funciona com cadastro manual; a busca no Google Maps mostra "ainda não ativada".
# Ative a "Places API (New)" no Google Cloud, crie uma chave restrita à API e defina uma cota/orçamento. Cota por plano: coluna plans.max_prospect_searches.
GOOGLE_PLACES_API_KEY=
# PageSpeed Insights (opcional, melhora a nota de velocidade na análise de sites)
GOOGLE_PAGESPEED_API_KEY=
