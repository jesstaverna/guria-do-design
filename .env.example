# ===== Supabase (projetos separados: dev / homologação / produção) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica   # pública por design; a segurança vem do RLS

# ===== Somente servidor — NUNCA prefixar com NEXT_PUBLIC_ =====
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que autoriza o agendador externo a chamar /api/worker
CRON_SECRET=gere-com-openssl-rand-hex-32
# URL pública do app (links de proposta/contrato/convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Google Drive (OPCIONAL) — seletor oficial de arquivos nas tarefas. Sem estas variáveis, o botão não aparece
# e o anexo por link continua funcionando. Passo a passo: docs/GOOGLE-DRIVE.md
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
