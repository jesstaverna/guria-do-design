# Token de verificação do webhook (você inventa; o mesmo valor vai no painel da Meta)
VERIFY_TOKEN=troque-por-uma-frase-secreta
# App Secret do app Meta (Configurações > Básico). Usado para validar a assinatura dos webhooks.
APP_SECRET=
# Token de acesso da conta do Instagram (gerado no painel do app, "Gerar token")
IG_ACCESS_TOKEN=
# ID da conta profissional do Instagram (a conta que recebe os comentários)
IG_USER_ID=
# Versão da Graph API
GRAPH_VERSION=v23.0
PORT=3000
DB_PATH=./data/guria.db
RULES_PATH=./config/rules.json
# true = só registra no log e NÃO envia nada para a Meta (bom para testar)
DRY_RUN=false
